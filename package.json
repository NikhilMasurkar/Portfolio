{
  "name": "nikhil-portfolio-v3",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "homepage": "/",
  "description": "Portfolio of Nikhil Masurkar — Frontend Engineer, React Native specialist",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-entry-weight.mjs && npm run build:server && node scripts/check-ssr-externals.mjs",
    "build:server": "vite build --config vite.config.server.js",
    "preview": "vite preview",
    "ssr": "node --env-file-if-exists=.env server/listen.cjs",
    "ssr:build": "npm run build && npm run ssr",
    "verify": "node scripts/verify.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint src server scripts tests netlify"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-presigned-post": "^3.1112.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@tinymce/tinymce-react": "^6.3.0",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "firebase": "^12.17.1",
    "jose": "^6.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "serverless-http": "^4.0.0",
    "tinymce": "^6.8.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.0",
    "vite": "^8.1.1"
  }
}
