# Copy to .env for local work. Set the same values in Netlify under
# Site settings → Environment variables.
#
# THE VITE_ PREFIX IS A SECURITY BOUNDARY, NOT A NAMING CONVENTION.
# Vite inlines every VITE_-prefixed var into the client bundle, where it is
# world-readable. Everything below the divider must never gain that prefix.
# `npm run verify` greps the built assets for the service-account key as a
# backstop.

# ---------------------------------------------------------------------------
# PUBLIC — shipped in the client bundle, and that is fine.
# Firebase web config identifies the project; it does not grant access.
# Access is decided by Firestore security rules.
# Firebase console → Project settings → General → Your apps → Web app → Config
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Site origin, for canonical tags in local builds. Production reads
# project.config.json instead.
VITE_SITE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# SECRET — server only. Never prefixed VITE_. Never committed.
# ---------------------------------------------------------------------------

# NOTE: there is deliberately no FIREBASE_SERVICE_ACCOUNT.
# Key creation is blocked on this project by a policy applied above it, and the
# project is personal, so there is no console in which to lift it. The server
# reads Firestore over the public REST API instead, governed by firestore.rules
# — see the header of server/db.js. This is the better position anyway: no
# long-lived secret to leak or rotate. Do not reintroduce one without reading
# that note first.

# The Google account allowed to write. Must match the address hardcoded in
# firestore.rules, which is the actual enforcement point — this variable alone
# grants nothing.
ADMIN_EMAIL=

# AWS S3 — uploads (resume PDF, project screenshots, avatar).
#
# THE _NEW SUFFIX IS NOT A TYPO. Netlify reserves AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY and AWS_REGION for its own build image and refuses to
# let you set them, so these carry a suffix to get around the collision.
# AWS_S3_BUCKET is not reserved, which is why it alone looks normal. Keep these
# names identical here and in Netlify or the upload route silently sees
# undefined.
AWS_REGION_NEW=ap-south-1
AWS_S3_BUCKET=nik-portfolio-new
AWS_ACCESS_KEY_ID_NEW=
AWS_SECRET_ACCESS_KEY_NEW=

# Public base URL objects are served from. The bucket's regional endpoint, or a
# CloudFront domain if one is put in front. No trailing slash.
S3_PUBLIC_BASE_URL=https://nik-portfolio-new.s3.ap-south-1.amazonaws.com

# Contact-form email notifications (P5). Without it, submissions are stored in
# Firestore and visible in the admin inbox, but nothing reaches your mailbox.
RESEND_API_KEY=
