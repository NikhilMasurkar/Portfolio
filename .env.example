# Copy to .env for local work. Set the same values in Netlify under
# Site settings → Environment variables.
#
# THE VITE_ PREFIX IS A SECURITY BOUNDARY, NOT A NAMING CONVENTION.
# Vite inlines every VITE_-prefixed var into the client bundle, where it is
# world-readable. Everything below the divider must never gain that prefix.
# `npm run verify` greps the built assets for the service-account key as a
# backstop.

# ---------------------------------------------------------------------------
# PUBLIC — shipped in the client bundle, and that is fine.
# Firebase web config identifies the project; it does not grant access.
# Access is decided by Firestore security rules.
# Firebase console → Project settings → General → Your apps → Web app → Config
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Site origin, for canonical tags in local builds. Production reads
# project.config.json instead.
VITE_SITE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# SECRET — server only. Never prefixed VITE_. Never committed.
# ---------------------------------------------------------------------------

# Firebase Admin SDK: Firestore reads for SSR, and ID-token verification on the
# upload route. Console → Project settings → Service accounts → Generate new
# private key, then base64 the whole JSON file:
#   base64 -i service-account.json | tr -d '\n'
# Base64 because the raw JSON contains newlines inside the private key, which
# .env and the Netlify UI both mangle.
FIREBASE_SERVICE_ACCOUNT=

# The Google account allowed to write. Everything in the admin panel is gated
# on this, in Firestore rules as well as in app code.
ADMIN_EMAIL=

# AWS S3 — uploads (resume PDF, project screenshots, avatar).
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public base URL objects are served from. The bucket's website endpoint, or a
# CloudFront domain if one is put in front. No trailing slash.
S3_PUBLIC_BASE_URL=

# Contact-form email notifications (P5). Without it, submissions are stored in
# Firestore and visible in the admin inbox, but nothing reaches your mailbox.
RESEND_API_KEY=
